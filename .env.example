# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MIDJOURNEY DISCORD API BRIDGE CONFIGURATION:
# Required for Slide 4 Midjourney /imagine automation via official Discord v9 HTTPS endpoints.
DISCORD_TOKEN="YOUR_DISCORD_USER_TOKEN"
GUILD_ID="YOUR_DISCORD_SERVER_GUILD_ID"
CHANNEL_ID="YOUR_DISCORD_CHANNEL_ID"
MIDJOURNEY_APP_ID="936929561302675456"
MIDJOURNEY_COMMAND_ID="938956540159881230"
MIDJOURNEY_COMMAND_VERSION="1240417417537359943"

# BYTEDANCE / BYTEPLUS MODELARK OFFICIAL API CONFIGURATION (Slide 4 Seedance Lab):
# Never commit real API keys. Configure BYTEDANCE_API_KEY (or ARK_API_KEY) in server environment secrets.
BYTEDANCE_API_KEY="YOUR_BYTEDANCE_ARK_API_KEY"
ARK_API_KEY=""
BYTEDANCE_BASE_URL="https://ark.ap-southeast.bytepluses.com/api/v3"
BYTEDANCE_SEEDANCE_MODEL="seedance-2-5-260628"
BYTEDANCE_SEEDREAM_MODEL="seedream-5-0-260128"

# MUAPI AI VIDEO PROVIDER CONFIGURATION (Seedance 2.5 Spicy):
# Backend-only API key header (x-api-key). Accepts MUAPIAPP_API_KEY or MUAPI_API_KEY (live) and MUAPI_SANDBOX_API_KEY (is_test sandbox). Never expose to frontend JS or logs.
MUAPIAPP_API_KEY="YOUR_MUAPI_API_KEY"
MUAPI_API_KEY=""
MUAPI_SANDBOX_API_KEY=""
MUAPI_BASE_URL="https://api.muapi.ai/api/v1"
MUAPI_CLIENT_NAME="vaiurenetwoek"

