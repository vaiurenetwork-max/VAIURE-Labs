rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Global default deny — never allow unauthenticated wildcard access or arbitrary file types
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true &&
          request.auth.token.email in ['rachvan420@gmail.com', 'vaiurenetwork@gmail.com', 'efayour@gmail.com'])
      );
    }

    // Strict allowlist — explicitly blocks SVG, HTML, scripts, and executables (prevents stored XSS)
    function isSafeImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function isSafeMedia() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)|video/(mp4|webm|quicktime)|audio/(mpeg|mp3|wav|ogg|webm|aac)');
    }

    // 1. User Media Vault Uploads (Owner upload with strict MIME/size check; signed-in or owner read)
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isSafeMedia();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }

    // 2. Threads Quarantine / Original Uploads: Restricted strictly to owner or verified admin
    match /threads/{userId}/{threadId}/original/{imageId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create, update: if isOwner(userId) && isSafeImage();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }

    match /threads/{userId}/{threadId}/quarantine/{imageId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create, update: if isOwner(userId) && isSafeImage();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }

    // 3. Optimized Editorial Variants & Thumbnails: Signed-in/public read of raster images only; owner write
    match /threads/{userId}/{threadId}/optimized/{imageId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isSafeImage();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }

    match /threads/{userId}/{threadId}/thumbnails/{imageId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isSafeImage();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }

    // 4. Unified AI Video & Image Generation Outputs (/generated-videos/{userId}/{jobId}/..., /generated-images/{userId}/{jobId}/...)
    match /generated-videos/{userId}/{jobId}/{fileName} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create, update: if isOwner(userId) && isSafeMedia();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }

    match /generated-images/{userId}/{jobId}/{fileName} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create, update: if isOwner(userId) && isSafeImage();
      allow delete: if isOwner(userId) || isPlatformAdmin();
    }
  }
}
