    },
    "conversations": {
      "title": "Direct Dispatch Conversation",
      "description": "Private messaging thread or collaboration negotiation between creators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "lastMessageText": { "type": "string", "maxLength": 1000 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
