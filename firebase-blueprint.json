{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Public user profile and account details for creators, curators, and readers",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_.-]+$" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bannerImage": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "accountType": {
          "type": "string",
          "enum": ["USER", "CREATOR", "ARTIST", "FILMMAKER", "PHOTOGRAPHER", "STUDIO", "BRAND", "EDITOR", "MODERATOR", "FINANCE", "SUPPORT", "ADMIN", "SUPER_ADMIN"]
        },
        "verified": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "EMAIL_UNVERIFIED", "RESTRICTED", "SUSPENDED", "DISABLED", "DELETION_PENDING", "DELETED"]
        },
        "suspensionReason": { "type": "string", "maxLength": 500 },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "deletionRequestedAt": { "type": "string" }
      },
      "required": ["uid", "username", "displayName", "email", "createdAt"]
    },
    "userSessions": {
      "title": "Active User Session",
      "description": "Registered device and browser login session for advanced logout control",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "deviceName": { "type": "string", "maxLength": 100 },
        "deviceType": { "type": "string", "maxLength": 50 },
        "browser": { "type": "string", "maxLength": 50 },
        "operatingSystem": { "type": "string", "maxLength": 50 },
        "approximateLocation": { "type": "string", "maxLength": 100 },
        "ipHash": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "current": { "type": "boolean" },
        "revokedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "REVOKED", "EXPIRED"] }
      },
      "required": ["sessionId", "uid", "deviceName", "status", "createdAt"]
    },
    "userSettings": {
      "title": "User Account & Privacy Settings",
      "description": "Preferences, security settings, notification toggles, and privacy controls",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "twoFactorEnabled": { "type": "boolean" },
        "profileVisibility": { "type": "string", "enum": ["PUBLIC", "CREATORS_ONLY", "PRIVATE"] },
        "whoCanFollow": { "type": "string", "enum": ["EVERYONE", "VERIFIED_ONLY"] },
        "whoCanMessage": { "type": "string", "enum": ["EVERYONE", "FOLLOWED_ONLY", "NO_ONE"] },
        "whoCanComment": { "type": "string", "enum": ["EVERYONE", "FOLLOWED_ONLY", "VERIFIED_ONLY"] },
        "whoCanMention": { "type": "string", "enum": ["EVERYONE", "FOLLOWED_ONLY", "NO_ONE"] },
        "activityVisibility": { "type": "boolean" },
        "onlineStatus": { "type": "boolean" },
        "readReceipts": { "type": "boolean" },
        "language": { "type": "string", "maxLength": 10 },
        "currency": { "type": "string", "maxLength": 10 },
        "timezone": { "type": "string", "maxLength": 50 },
        "theme": { "type": "string", "enum": ["DARK", "LIGHT", "SYSTEM"] },
        "reducedMotion": { "type": "boolean" },
        "animationIntensity": { "type": "string", "enum": ["SUBTLE", "STANDARD", "CINEMATIC"] },
        "interfaceDensity": { "type": "string", "enum": ["COMPACT", "COMFORTABLE", "EXPANSIVE"] },
        "notifications": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "updatedAt"]
    },
    "usernames": {
      "title": "Username Reservation",
      "description": "Unique username registry doc mapped to user uid to prevent duplicates",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_.-]+$" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "posts": {
      "title": "Archival Social Post",
      "description": "High-fashion, cinematic film, and generative art posts published by creators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorDisplayName": { "type": "string", "maxLength": 100 },
        "authorPhotoURL": { "type": "string", "maxLength": 500 },
        "authorVerified": { "type": "boolean" },
        "authorAccountType": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "caption": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 50 },
        "aiDisclosure": { "type": "string", "maxLength": 50 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "repostsCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "authorUid", "authorUsername", "title", "category", "createdAt"]
    },
    "postLikes": {
      "title": "Post Like",
      "description": "User like record for an archival post",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["postId", "userId", "createdAt"]
    },
    "postComments": {
      "title": "Post Comment",
      "description": "Comment and editorial discussion on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "postId", "authorId", "content", "createdAt"]
    },
    "userCollections": {
      "title": "User Collection / Moodboard",
      "description": "Curated moodboard collection created by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "isPrivate": { "type": "boolean" },
        "coverImage": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "savedPosts": {
      "title": "Saved Post Record",
      "description": "Marker indicating a user has saved a post to their personal vault",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "savedAt": { "type": "string" }
      },
      "required": ["postId", "userId", "savedAt"]
    },
    "follows": {
      "title": "Social Follow",
      "description": "Social graph relationship between creator and follower",
      "type": "object",
      "properties": {
        "followerUid": { "type": "string", "maxLength": 128 },
        "targetUid": { "type": "string", "maxLength": 128 },
